{{!-- Dois cards por Interagir: o público só anuncia a ação; o do mestre traz a
      descrição contextual e diz que é só dele (achado em uso real). --}}
<div class="op2 op2-card op2-card--investigacao{{#if soMestre}} op2-card--mestre{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{localize "OP2.Investigacao.Interagir"}}</span>
    <span class="op2-card__dt">{{poiNome}}</span>
  </header>

  <p class="op2-card__texto">{{quemInterage}}</p>
  {{#if soMestre}}
    <p class="op2-card__so-mestre">
      <i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{localize "OP2.Investigacao.InteragirSoMestre"}}
    </p>
    {{#if descricaoContextual}}
      <div class="op2-card__texto op2-card__contextual">{{{descricaoContextual}}}</div>
    {{else}}
      <p class="op2-ajuda">{{localize "OP2.Investigacao.InteragirSemContextual"}}</p>
    {{/if}}
    {{!-- Linhas ocultas com itens: o que o ponto entrega a quem interage (as pedras
          rúnicas da Caverna). Um item por vez, para quem o mestre escolher. --}}
    {{#each guardados}}
      <div class="op2-card__itens-pista" data-info-id="{{infoId}}">
        <p class="op2-ajuda"><i class="fa-solid fa-box-open" aria-hidden="true"></i> {{localize "OP2.Investigacao.InteragirGuardados"}}</p>
        <div class="op2-card__texto">{{{texto}}}</div>
        <ul class="op2-card__itens-lista">
          {{#each itens}}
            <li class="op2-card__item-pista" data-item-uuid="{{uuid}}">
              <img src="{{img}}" alt=""> <span>{{nome}}</span>
              <button type="button" class="op2-botao-icone" data-op2-gm data-op2-acao="entregar-item-desafio" data-info-id="{{../infoId}}"
                data-item-uuid="{{uuid}}" aria-label="{{localize 'OP2.ItensPista.EntregarUm'}}"
                data-tooltip="{{localize 'OP2.ItensPista.EntregarUm'}}"><i class="fa-solid fa-hand-holding"></i></button>
            </li>
          {{/each}}
        </ul>
      </div>
    {{/each}}
  {{else}}
    <p class="op2-ajuda">{{localize "OP2.Investigacao.InteragirAguarde"}}</p>
    {{!-- O mestre narra ou pede um teste: o botão abre o Solicitar teste já preenchido. --}}
    <div class="op2-card__acoes" data-op2-gm>
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-acao="interagir-solicitar-teste"
        data-ator-id="{{atorId}}" data-poi-uuid="{{poiUuid}}">
        <i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "OP2.Investigacao.InteragirSolicitarTeste"}}
      </button>
    </div>
  {{/if}}
</div>
