<div class="op2 op2-card op2-card--investigacao">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{total}}</span>
  </header>

  <p class="op2-card__texto">{{texto}}</p>
  {{#if guardiaNota}}<p class="op2-prontidao-nota op2-guardia-nota"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{guardiaNota}}</p>{{/if}}

  {{!-- Com defesa: o teste do alvo abre sozinho para quem joga com ele; o botão é a reserva. --}}
  {{#if defesa}}
  <div class="op2-card__acoes">
    <button type="button" class="op2-botao op2-botao--pequeno" data-op2-acao="defender-ataque"
      data-ator-id="{{alvoId}}" data-ator-uuid="{{alvoUuid}}" data-atacante-id="{{atacanteId}}" data-total="{{total}}"
      data-ra="{{ra}}" data-rb="{{rb}}" data-dano-base="{{danoBase}}" data-dano-bonus="{{danoBonus}}" data-pericia="{{defesa.pericia}}">
      <i class="fa-solid fa-shield"></i> {{localize "OP2.Defesa.Rolar"}}
    </button>
  </div>
  {{else if acertou}}
  <div class="op2-card__acoes">
    <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo" data-op2-acao="dano-ataque"
      data-ator-id="{{alvoId}}" data-ator-uuid="{{alvoUuid}}" data-quantidade="{{dano}}">
      {{localize "OP2.Combate.AplicarDano" nome=alvoNome dano=dano}}
    </button>
  </div>
  {{/if}}
</div>
