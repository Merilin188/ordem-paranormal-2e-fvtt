<section class="op2-painel tab {{tabs.inventario.cssClass}}" data-group="principal" data-tab="inventario">
  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Inventario"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="criarItem" data-tipo="equipamento">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Equipamento.Adicionar"}}
      </button>
    {{/if}}
  </div>

  <div class="op2-armadura-inv">
    <div class="op2-armadura">
      <span>{{localize "OP2.Armadura.Pontos"}}</span>
      <strong class="op2-armadura__valor">{{sistema.armadura.value}} / {{sistema.armadura.max}}</strong>
      <label class="op2-armadura__gastos">{{localize "OP2.Armadura.Gastos"}}
        <input type="number" name="system.armadura.gastos" value="{{sistema.armadura.gastos}}" min="0" {{#unless editavel}}disabled{{/unless}}>
      </label>
      <small>{{#if sistema.armadura.fontes}}{{localize "OP2.Armadura.Fontes"}}: {{sistema.armadura.fontes}}{{else}}{{localize "OP2.Armadura.SemItens"}}{{/if}}</small>
    </div>
    <p class="op2-ajuda">{{localize "OP2.Armadura.Regra"}}</p>
  </div>

  {{#if equipamentos.length}}
    <ul class="op2-lista-itens op2-lista-itens--inventario">
      {{#each equipamentos}}
        <li class="op2-item{{#if system.equipado}} op2-item--equipado{{/if}}{{#if op2Simbolo}} op2-item--passiva{{#if op2Gasto}} op2-item--apagada{{/if}}{{/if}}" data-item-id="{{id}}">
          <img class="op2-item__icone" src="{{img}}" alt="">
          {{!-- Item com passiva: o símbolo brilha enquanto vale; gasto, fica apagado. --}}
          {{#if op2Simbolo}}
            <span class="op2-item__runa" data-tooltip="{{#if op2Gasto}}{{#if op2MensagemGasto}}{{op2MensagemGasto}}{{else}}{{localize 'OP2.Uso.PassivaApagada'}}{{/if}}{{else}}{{localize 'OP2.Uso.PassivaAtiva'}}{{/if}}">
              <img src="systems/ordem-paranormal-2e/assets/icons/runa-brenna.svg" alt="">
            </span>
          {{/if}}

          {{!-- Sempre visível: equipado é um estado que interessa ver de relance na
                lista, não só ao abrir a ficha do item. --}}
          <button type="button" class="op2-item__equipado{{#if system.equipado}} op2-item__equipado--ativo{{/if}}"
            data-action="alternarEquipado" aria-pressed="{{system.equipado}}"
            data-tooltip="{{#if system.equipado}}{{localize 'OP2.Equipamento.Equipado'}}{{else}}{{localize 'OP2.Equipamento.NaoEquipado'}}{{/if}}"
            aria-label="{{localize 'OP2.Equipamento.AlternarEquipado'}}"
            {{#unless @root.editavel}}disabled{{/unless}}>
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          </button>

          <div class="op2-item__texto">
            <button type="button" class="op2-item__nome" data-action="editarItem">{{name}}</button>
            <span class="op2-item__meta">
              {{#if (op2Eq system.quantidade 1)}}{{else}}×{{system.quantidade}} · {{/if}}
              {{#if system.arma}}{{localize "OP2.Equipamento.Arma"}}{{/if}}
            </span>
          </div>

          {{#if op2TemUso}}
            <button type="button" class="op2-botao op2-botao--pequeno op2-item__usar" data-action="usarItem"
              {{#unless @root.editavel}}disabled{{/unless}}
              data-tooltip="{{#if op2Gasto}}{{#if op2MensagemGasto}}{{op2MensagemGasto}}{{else}}{{localize 'OP2.Uso.JaGastoCurto'}}{{/if}}{{else}}{{localize 'OP2.Uso.UsarDica'}}{{/if}}">
              <i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> {{localize "OP2.Uso.Usar"}}
            </button>
          {{/if}}
          {{#if system.cargas.usa}}
            <div class="op2-item__cargas" role="group" aria-label="{{localize 'OP2.Equipamento.Cargas'}}">
              <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="-1"
                aria-label="{{localize 'OP2.Equipamento.DiminuirCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                <i class="fa-solid fa-minus" aria-hidden="true"></i>
              </button>
              <span class="op2-item__cargas-valor">{{system.cargas.value}}/{{system.cargas.max}}</span>
              <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="1"
                aria-label="{{localize 'OP2.Equipamento.AumentarCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            </div>
          {{/if}}

          {{#if @root.editavel}}
            <button type="button" class="op2-botao-icone" data-action="apagarItem"
              data-tooltip="{{localize 'OP2.Item.Apagar'}}" aria-label="{{localize 'OP2.Item.Apagar'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="op2-vazio">{{localize "OP2.Equipamento.Vazio"}}</p>
  {{/if}}

  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Ferramentas"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="criarItem" data-tipo="ferramenta">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Ferramenta.Adicionar"}}
      </button>
    {{/if}}
  </div>

  {{#if ferramentas.length}}
    <ul class="op2-lista-itens op2-lista-itens--ferramentas">
      {{#each ferramentas}}
        <li class="op2-item" data-item-id="{{id}}">
          <img class="op2-item__icone" src="{{img}}" alt="">

          <div class="op2-item__texto">
            <button type="button" class="op2-item__nome" data-action="editarItem">{{name}}</button>
            <span class="op2-item__meta">{{localize (op2Concat "OP2.Ferramenta.Subtipo." system.subtipo)}}</span>
          </div>

          {{#if system.cargas.usa}}
            <div class="op2-item__cargas" role="group" aria-label="{{localize 'OP2.Equipamento.Cargas'}}">
              <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="-1"
                aria-label="{{localize 'OP2.Equipamento.DiminuirCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                <i class="fa-solid fa-minus" aria-hidden="true"></i>
              </button>
              <span class="op2-item__cargas-valor">{{system.cargas.value}}/{{system.cargas.max}}</span>
              <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="1"
                aria-label="{{localize 'OP2.Equipamento.AumentarCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
              </button>
            </div>
          {{/if}}

          {{#if @root.editavel}}
            <button type="button" class="op2-botao-icone" data-action="apagarItem"
              data-tooltip="{{localize 'OP2.Item.Apagar'}}" aria-label="{{localize 'OP2.Item.Apagar'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="op2-vazio">{{localize "OP2.Ferramenta.Vazio"}}</p>
  {{/if}}
</section>
