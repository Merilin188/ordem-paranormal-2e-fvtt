<section class="op2-painel tab {{tabs.inventario.cssClass}}" data-group="principal" data-tab="inventario">
  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Inventario"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="criarItem" data-tipo="equipamento">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Equipamento.Adicionar"}}
      </button>
    {{/if}}
  </div>

  <div class="op2-armadura-inv">
    <div class="op2-armadura">
      <span>{{localize "OP2.Armadura.Pontos"}}</span>
      <strong class="op2-armadura__valor">{{sistema.armadura.value}} / {{sistema.armadura.max}}</strong>
      <label class="op2-armadura__gastos">{{localize "OP2.Armadura.Gastos"}}
        <input type="number" name="system.armadura.gastos" value="{{sistema.armadura.gastos}}" min="0" {{#unless editavel}}disabled{{/unless}}>
      </label>
      <small>{{#if sistema.armadura.fontes}}{{localize "OP2.Armadura.Fontes"}}: {{sistema.armadura.fontes}}{{else}}{{localize "OP2.Armadura.SemItens"}}{{/if}}</small>
    </div>
    <p class="op2-ajuda">{{localize "OP2.Armadura.Regra"}}</p>
  </div>

  {{#if equipamentos.length}}
    <ul class="op2-lista-itens">
      {{#each equipamentos}}
        <li class="op2-item op2-linha{{#if equipado}} op2-item--equipado{{/if}}{{#if simbolo}} op2-item--passiva{{#if gasto}} op2-item--apagada{{/if}}{{/if}}" data-item-id="{{item.id}}">
          <img class="op2-item__icone" src="{{item.img}}" alt="">
          <div class="op2-linha__corpo">
            <div class="op2-linha__cabeca">
              {{!-- Clicar no nome USA o item: rola e aplica o efeito, ou leva ao chat. --}}
              <button type="button" class="op2-linha__usar" data-action="usarLinha" data-tooltip="{{dicaUsar}}"
                {{#unless @root.editavel}}disabled{{/unless}}>
                <span class="op2-linha__nome">{{item.name}}</span>
                {{#if simbolo}}
                  <span class="op2-item__runa" data-tooltip="{{dicaSimbolo}}"><img src="systems/ordem-paranormal-2e/assets/icons/runa-brenna.svg" alt=""></span>
                {{/if}}
              </button>
              <button type="button" class="op2-item__equipado{{#if equipado}} op2-item__equipado--ativo{{/if}}"
                data-action="alternarEquipado" aria-pressed="{{equipado}}"
                data-tooltip="{{#if equipado}}{{localize 'OP2.Equipamento.Equipado'}}{{else}}{{localize 'OP2.Equipamento.NaoEquipado'}}{{/if}}"
                aria-label="{{localize 'OP2.Equipamento.AlternarEquipado'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              </button>
            {{#if cargas}}
              <span class="op2-item__cargas" role="group" aria-label="{{localize 'OP2.Equipamento.Cargas'}}">
                <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="-1"
                  aria-label="{{localize 'OP2.Equipamento.DiminuirCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                  <i class="fa-solid fa-minus" aria-hidden="true"></i>
                </button>
                <span class="op2-item__cargas-valor">{{cargas.value}}/{{cargas.max}}</span>
                <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="1"
                  aria-label="{{localize 'OP2.Equipamento.AumentarCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
              </span>
            {{/if}}
              {{#if @root.editavel}}
                <button type="button" class="op2-botao-icone op2-linha__acao" data-action="editarItem"
                  data-tooltip="{{localize 'OP2.Item.Editar'}}" aria-label="{{localize 'OP2.Item.Editar'}}">
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                </button>
                <button type="button" class="op2-botao-icone op2-linha__acao op2-linha__acao--perigo" data-action="apagarItem"
                  data-tooltip="{{localize 'OP2.Item.Apagar'}}" aria-label="{{localize 'OP2.Item.Apagar'}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
            {{#if meta}}<span class="op2-item__meta">{{meta}}</span>{{/if}}
            {{#if descricao}}<div class="op2-item__descricao">{{{descricao}}}</div>{{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="op2-vazio">{{localize "OP2.Equipamento.Vazio"}}</p>
  {{/if}}

  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Ferramentas"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="criarItem" data-tipo="ferramenta">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Ferramenta.Adicionar"}}
      </button>
    {{/if}}
  </div>

  {{#if ferramentas.length}}
    <ul class="op2-lista-itens">
      {{#each ferramentas}}
        <li class="op2-item op2-linha" data-item-id="{{item.id}}">
          <img class="op2-item__icone" src="{{item.img}}" alt="">
          <div class="op2-linha__corpo">
            <div class="op2-linha__cabeca">
              <button type="button" class="op2-linha__usar" data-action="usarLinha" data-tooltip="{{dicaUsar}}"
                {{#unless @root.editavel}}disabled{{/unless}}>
                <span class="op2-linha__nome">{{item.name}}</span>
              </button>
            {{#if cargas}}
              <span class="op2-item__cargas" role="group" aria-label="{{localize 'OP2.Equipamento.Cargas'}}">
                <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="-1"
                  aria-label="{{localize 'OP2.Equipamento.DiminuirCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                  <i class="fa-solid fa-minus" aria-hidden="true"></i>
                </button>
                <span class="op2-item__cargas-valor">{{cargas.value}}/{{cargas.max}}</span>
                <button type="button" class="op2-botao-icone" data-action="ajustarCarga" data-delta="1"
                  aria-label="{{localize 'OP2.Equipamento.AumentarCarga'}}" {{#unless @root.editavel}}disabled{{/unless}}>
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
              </span>
            {{/if}}
              {{#if @root.editavel}}
                <button type="button" class="op2-botao-icone op2-linha__acao" data-action="editarItem"
                  data-tooltip="{{localize 'OP2.Item.Editar'}}" aria-label="{{localize 'OP2.Item.Editar'}}">
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                </button>
                <button type="button" class="op2-botao-icone op2-linha__acao op2-linha__acao--perigo" data-action="apagarItem"
                  data-tooltip="{{localize 'OP2.Item.Apagar'}}" aria-label="{{localize 'OP2.Item.Apagar'}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
            {{#if meta}}<span class="op2-item__meta">{{meta}}</span>{{/if}}
            {{#if descricao}}<div class="op2-item__descricao">{{{descricao}}}</div>{{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="op2-vazio">{{localize "OP2.Ferramenta.Vazio"}}</p>
  {{/if}}
</section>
