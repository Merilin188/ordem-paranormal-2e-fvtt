<section class="op2-painel op2-painel--relacoes tab {{tabs.relacoes.cssClass}}" data-group="principal" data-tab="relacoes">
  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Relacoes.Titulo"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="adicionarRelacao">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Relacoes.Adicionar"}}
      </button>
    {{/if}}
  </div>
  <p class="op2-ajuda">{{localize "OP2.Relacoes.Ajuda"}}</p>

  <ol class="op2-relacoes">
    {{#each relacoes}}
      <li class="op2-relacao {{#if invocada}}op2-relacao--invocada{{/if}}">
        <label class="op2-relacao__campo op2-relacao__campo--nome">
          <span>{{localize "OP2.Relacoes.Nome"}}</span>
          <input type="text" data-relacao-campo="nome" data-indice="{{indice}}" value="{{nome}}"
            placeholder="Rowan" {{#unless ../editavel}}disabled{{/unless}}>
        </label>
        <div class="op2-relacao__campo op2-relacao__campo--grau">
          <span>{{localize "OP2.Relacoes.Grau"}}</span>
          <span class="op2-relacao__grau" role="group">
            {{#each circulos}}
              <button type="button" class="op2-relacao__circulo {{#if cheio}}cheio{{/if}}" data-action="definirGrau"
                data-indice="{{../indice}}" data-grau="{{n}}" data-tooltip="{{localize (op2Concat 'OP2.Relacoes.Grau' n)}}"
                {{#unless @root.editavel}}disabled{{/unless}}></button>
            {{/each}}
          </span>
        </div>
        <label class="op2-relacao__campo op2-relacao__campo--rotulo">
          <span>{{localize "OP2.Relacoes.Rotulo"}}</span>
          <input type="text" data-relacao-campo="rotulo" data-indice="{{indice}}" value="{{rotulo}}"
            placeholder="{{localize 'OP2.Relacoes.RotuloExemplo'}}" {{#unless ../editavel}}disabled{{/unless}}>
        </label>
        <div class="op2-relacao__acoes">
          <label class="op2-relacao__invocada" data-tooltip="{{localize 'OP2.Relacoes.InvocadaDica'}}">
            <input type="checkbox" data-action="alternarInvocada" data-indice="{{indice}}" {{#if invocada}}checked{{/if}} {{#unless ../editavel}}disabled{{/unless}}>
            {{localize "OP2.Relacoes.Invocada"}}
          </label>
          {{#if ../editavel}}
            <button type="button" class="op2-botao-icone" data-action="removerRelacao" data-indice="{{indice}}"
              data-tooltip="{{localize 'OP2.Relacoes.Remover'}}" aria-label="{{localize 'OP2.Relacoes.Remover'}}"><i class="fa-solid fa-trash"></i></button>
          {{/if}}
        </div>
        <label class="op2-relacao__campo op2-relacao__campo--descricao">
          <span>{{localize "OP2.Relacoes.Descricao"}}</span>
          <textarea rows="2" data-relacao-campo="descricao" data-indice="{{indice}}"
            placeholder="{{localize 'OP2.Relacoes.DescricaoExemplo'}}" {{#unless ../editavel}}disabled{{/unless}}>{{descricao}}</textarea>
        </label>
      </li>
    {{else}}
      <li class="op2-ajuda">{{localize "OP2.Relacoes.Vazio"}}</li>
    {{/each}}
  </ol>

  <details class="op2-relacoes__regras">
    <summary>{{localize "OP2.Relacoes.Beneficios"}}</summary>
    <p>{{localize "OP2.Relacoes.Invocar"}}</p>
    <p><strong>{{localize "OP2.Relacoes.Grau1"}}:</strong> {{localize "OP2.Relacoes.Beneficio1"}}</p>
    <p><strong>{{localize "OP2.Relacoes.Grau2"}}:</strong> {{localize "OP2.Relacoes.Beneficio2"}}</p>
    <p><strong>{{localize "OP2.Relacoes.Grau3"}}:</strong> {{localize "OP2.Relacoes.Beneficio3"}}</p>
  </details>
</section>
