<div class="op2-pericias-mundo__corpo">
  <p class="op2-dica">{{localize "OP2.PericiasMundo.Ajuda"}}</p>

  <table class="op2-pericias-mundo__tabela">
    <thead>
      <tr>
        <th>{{localize "OP2.PericiasMundo.Exibir"}}</th>
        <th>{{localize "OP2.PericiasMundo.Pericia"}}</th>
        <th>{{localize "OP2.PericiasMundo.NomeNaMesa"}}</th>
        <th>{{localize "OP2.PericiasMundo.Atributo"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each linhas}}
        <tr>
          <td><input type="checkbox" data-visivel="{{chave}}" {{#if visivel}}checked{{/if}}></td>
          <td>{{original}}</td>
          <td><input type="text" data-nome="{{chave}}" value="{{nome}}" placeholder="{{original}}"></td>
          <td class="op2-pericias-mundo__fixo">{{atributo}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h3>{{localize "OP2.PericiasMundo.Novas"}}</h3>
  {{#if novas.length}}
    <table class="op2-pericias-mundo__tabela">
      <tbody>
        {{#each novas}}
          <tr data-nova="{{chave}}">
            <td><input type="checkbox" data-visivel="{{chave}}" {{#if visivel}}checked{{/if}}></td>
            <td><input type="text" name="rotulo" value="{{rotulo}}"></td>
            <td><select name="die">{{#each dados}}<option value="{{d}}" {{#if sel}}selected{{/if}}>{{rotulo}}</option>{{/each}}</select></td>
            <td><select name="atributo">{{#each atributos}}<option value="{{c}}" {{#if sel}}selected{{/if}}>{{rotulo}}</option>{{/each}}</select></td>
            <td><button type="button" class="op2-botao-icone" data-action="remover" data-chave="{{chave}}"
              data-tooltip="{{localize 'OP2.PericiasMundo.Remover'}}"><i class="fa-solid fa-trash"></i></button></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="op2-dica">{{localize "OP2.PericiasMundo.Nenhuma"}}</p>
  {{/if}}

  <div class="op2-pericias-mundo__nova">
    <input type="text" name="novoNome" placeholder="{{localize 'OP2.PericiasMundo.NovoNome'}}">
    <select name="novoDado">{{#each dados}}<option value="{{d}}">{{rotulo}}</option>{{/each}}</select>
    <select name="novoAtributo">{{#each atributos}}<option value="{{c}}">{{rotulo}}</option>{{/each}}</select>
    <button type="button" class="op2-botao" data-action="adicionar"><i class="fa-solid fa-plus"></i> {{localize "OP2.PericiasMundo.Adicionar"}}</button>
  </div>

  <h3>{{localize "OP2.PericiasMundo.Aptidoes"}}</h3>
  <p class="op2-dica">{{localize "OP2.PericiasMundo.AptidoesAjuda"}}</p>
  <table class="op2-pericias-mundo__tabela">
    <thead>
      <tr>
        <th>{{localize "OP2.PericiasMundo.Exibir"}}</th>
        <th>{{localize "OP2.PericiasMundo.Campo"}}</th>
        <th>{{localize "OP2.PericiasMundo.NomeNaMesa"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each aptLinhas}}
        <tr>
          <td><input type="checkbox" data-apt-visivel="{{chave}}" {{#if visivel}}checked{{/if}}></td>
          <td>{{original}}</td>
          <td><input type="text" data-apt-nome="{{chave}}" value="{{nome}}" placeholder="{{original}}"></td>
        </tr>
      {{/each}}
      {{#each aptNovas}}
        <tr data-apt-nova="{{chave}}">
          <td><input type="checkbox" data-apt-visivel="{{chave}}" {{#if visivel}}checked{{/if}}></td>
          <td><input type="text" name="rotulo" value="{{rotulo}}"></td>
          <td class="op2-pericias-mundo__acoes">
            <select name="die">{{#each dados}}<option value="{{d}}" {{#if sel}}selected{{/if}}>{{rotulo}}</option>{{/each}}</select>
            <button type="button" class="op2-botao-icone" data-action="removerApt" data-chave="{{chave}}"
              data-tooltip="{{localize 'OP2.PericiasMundo.RemoverCampo'}}"><i class="fa-solid fa-trash"></i></button>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="op2-pericias-mundo__nova">
    <input type="text" name="novoAptNome" placeholder="{{localize 'OP2.PericiasMundo.NovoCampo'}}">
    <select name="novoAptDado">{{#each dados}}<option value="{{d}}">{{rotulo}}</option>{{/each}}</select>
    <button type="button" class="op2-botao" data-action="adicionarApt"><i class="fa-solid fa-plus"></i> {{localize "OP2.PericiasMundo.Adicionar"}}</button>
  </div>

  <footer class="op2-pericias-mundo__rodape">
    <button type="button" class="op2-botao op2-botao--fantasma" data-action="restaurar">
      <i class="fa-solid fa-rotate-left"></i> {{localize "OP2.PericiasMundo.Restaurar"}}</button>
    <button type="submit" class="op2-botao"><i class="fa-solid fa-floppy-disk"></i> {{localize "OP2.PericiasMundo.Salvar"}}</button>
  </footer>
</div>
