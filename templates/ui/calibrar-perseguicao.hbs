{{!-- Calibrar os efeitos da perseguição: cada grupo liga/desliga e tem seus números.
      Salvar aplica na hora para todos que estão na cena. --}}
<div class="op2-calibrar__corpo">
  <p class="op2-ajuda">{{localize "OP2.EfeitosPerseguicao.Intro"}}</p>
  {{#each grupos}}
    <fieldset class="op2-calibrar__grupo">
      <legend>
        <label class="op2-campo op2-campo--inline">
          <input type="checkbox" name="{{id}}.ligado" {{#if ligado}}checked{{/if}}>
          <span>{{titulo}}</span>
        </label>
      </legend>
      <p class="op2-ajuda">{{ajuda}}</p>
      <div class="op2-calibrar__campos">
        {{#each campos}}
          <label class="op2-campo">
            <span>{{rotulo}} <small>({{min}}–{{max}})</small></span>
            <input type="number" name="{{nome}}" value="{{valor}}" min="{{min}}" max="{{max}}" step="{{passo}}">
          </label>
        {{/each}}
        {{#if cor}}
          <label class="op2-campo">
            <span>{{localize "OP2.EfeitosPerseguicao.Campo.nevoa.cor"}}</span>
            <input type="color" name="nevoa.cor" value="{{cor}}">
          </label>
        {{/if}}
      </div>
      {{#if testar}}
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="testarPisada">
          <i class="fa-solid fa-shoe-prints" aria-hidden="true"></i> {{localize "OP2.EfeitosPerseguicao.TestarPisada"}}
        </button>
      {{/if}}
    </fieldset>
  {{/each}}
  <footer class="op2-calibrar__rodape">
    <button type="button" class="op2-botao op2-botao--fantasma" data-action="restaurar">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "OP2.EfeitosPerseguicao.Restaurar"}}
    </button>
    <button type="submit" class="op2-botao">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "OP2.EfeitosPerseguicao.Salvar"}}
    </button>
  </footer>
</div>
