<div class="op2-cena-config__corpo">
  <fieldset>
    <legend>{{localize "OP2.CenaConfig.Geral"}}</legend>
    <label>{{localize "OP2.CenaConfig.Nome"}}<input type="text" name="nome" value="{{c.nome}}"></label>
    <div class="op2-cena-config__grade">
      <label data-tooltip="{{localize 'OP2.CenaConfig.DtBaseDica'}}">{{localize "OP2.CenaConfig.DtBase"}}<input type="number" name="dtBase" value="{{c.dtBase}}" min="1"></label>
      <label>{{localize "OP2.CenaConfig.DtPasso"}}<input type="number" name="dtPasso" value="{{c.dtPasso}}" min="0"></label>
      <label data-tooltip="{{localize 'OP2.CenaConfig.DanoEncontradoDica'}}">{{localize "OP2.CenaConfig.DanoEncontrado"}}<input type="text" name="danoEncontrado" value="{{c.danoEncontrado}}"></label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "OP2.CenaConfig.TabelaCriaturas"}}</legend>
    <p class="op2-dica">{{localize "OP2.CenaConfig.TabelaAjuda"}}</p>
    {{#each linhas}}
      <div class="op2-cena-config__bloco op2-cena-config__tabela" data-linha="{{n}}">
        <div class="op2-cena-config__linha">
          <strong class="op2-cena-config__d10">{{n}}</strong>
          <select name="tipo">{{#each tipos}}<option value="{{t}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select>
          <input type="text" name="formula" value="{{formula}}" placeholder="1d10 | 1d12, 2d10, 3d8" data-tooltip="{{localize 'OP2.CenaConfig.FormulaDica'}}">
        </div>
        <textarea name="texto" rows="2" placeholder="{{padrao}}">{{texto}}</textarea>
      </div>
    {{/each}}
  </fieldset>

  <footer class="op2-cena-config__rodape">
    {{#if podeExcluir}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="excluirCena"><i class="fa-solid fa-trash"></i> {{localize "OP2.CenaConfig.Excluir"}}</button>{{/if}}
    <button type="submit" class="op2-botao"><i class="fa-solid fa-floppy-disk"></i> {{localize "OP2.CenaConfig.Salvar"}}</button>
  </footer>
</div>
