<div class="op2-cena-config__corpo">
  <fieldset>
    <legend>{{localize "OP2.CenaConfig.Geral"}}</legend>
    <label>{{localize "OP2.CenaConfig.Nome"}}<input type="text" name="nome" value="{{c.nome}}"></label>
    <div class="op2-cena-config__grade">
      <label data-tooltip="{{localize 'OP2.CenaConfig.DtBaseDica'}}">{{localize "OP2.CenaConfig.DtBase"}}<input type="number" name="dtBase" value="{{c.dtBase}}" min="1"></label>
      <label>{{localize "OP2.CenaConfig.DtPasso"}}<input type="number" name="dtPasso" value="{{c.dtPasso}}" min="0"></label>
      <label data-tooltip="{{localize 'OP2.CenaConfig.DanoEncontradoDica'}}">{{localize "OP2.CenaConfig.DanoEncontrado"}}<input type="text" name="danoEncontrado" value="{{c.danoEncontrado}}"></label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "OP2.CenaConfig.TabelaCriaturas"}}</legend>
    <p class="op2-dica">{{localize "OP2.CenaConfig.TabelaAjuda"}}</p>
    {{#each linhas}}
      <div class="op2-cena-config__bloco op2-cena-config__tabela" data-linha="{{n}}">
        <div class="op2-cena-config__linha">
          <strong class="op2-cena-config__d10">{{n}}</strong>
          <select name="tipo">{{#each tipos}}<option value="{{t}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select>
          <input type="text" name="formula" value="{{formula}}" placeholder="1d10 | 1d12, 2d10, 3d8" data-tooltip="{{localize 'OP2.CenaConfig.FormulaDica'}}">
        </div>
        <textarea name="texto" rows="2" placeholder="{{padrao}}">{{texto}}</textarea>
      </div>
    {{/each}}
  </fieldset>

  {{!-- Travessia: as áreas que o grupo cruza durante a furtividade. Cada ação é um
        teste; soma avanços sempre (o teste só decide o dano) ou só passando. --}}
  <fieldset class="op2-cena-config__travessia">
    <legend>{{localize "OP2.CenaConfig.Travessia"}}</legend>
    <p class="op2-dica">{{localize "OP2.CenaConfig.TravessiaAjuda"}}</p>
    <button type="button" class="op2-botao op2-botao--pequeno op2-botao--fantasma" data-action="carregarMissao1"
      data-tooltip="{{localize 'OP2.CenaConfig.CarregarMissao1Dica'}}"><i class="fa-solid fa-route"></i> {{localize "OP2.CenaConfig.CarregarMissao1"}}</button>
    {{#each areas}}
      <div class="op2-cena-config__bloco op2-cena-config__area" data-area-bloco="{{ai}}">
        <div class="op2-cena-config__linha">
          <label class="op2-cena-config__area-nome">{{localize "OP2.CenaConfig.AreaNome"}}<input type="text" name="areaNome" value="{{nome}}"></label>
          <label>{{localize "OP2.CenaConfig.AreaAvancos"}}<input type="number" name="areaAvancos" value="{{avancos}}" min="1"></label>
          <label data-tooltip="{{localize 'OP2.CenaConfig.AreaCenaDica'}}">{{localize "OP2.CenaConfig.AreaCena"}}<select name="areaCena"><option value="">—</option>{{#each cenas}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{nome}}</option>{{/each}}</select></label>
          <button type="button" class="op2-botao-icone" data-action="remover" data-lista="areas" data-i="{{ai}}" data-tooltip="{{localize 'OP2.CenaConfig.RemoverArea'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{!-- Penalidade da área (Escuridão): a partir de N avanços, passos em todos os testes. --}}
        <div class="op2-cena-config__linha op2-cena-config__penalidade" data-tooltip="{{localize 'OP2.CenaConfig.PenalidadeDica'}}">
          <label>{{localize "OP2.CenaConfig.PenalidadeNome"}}<input type="text" name="penNome" value="{{penalidade.nome}}" placeholder="{{localize 'OP2.CenaConfig.PenalidadeExemplo'}}"></label>
          <label class="op2-cena-config__curto">{{localize "OP2.CenaConfig.PenalidadeAPartir"}}<input type="number" name="penAPartir" value="{{penalidade.aPartir}}" min="0"></label>
          <label class="op2-cena-config__curto">{{localize "OP2.CenaConfig.PenalidadePassos"}}<input type="number" name="penPassos" value="{{penalidade.passos}}" max="-1"></label>
        </div>
        <div class="op2-cena-config__acoes-area">
          {{#if acoes.length}}
            <div class="op2-cena-config__acao-area op2-cena-config__acao-cabeca" aria-hidden="true">
              <span>{{localize "OP2.CenaConfig.AcaoNome"}}</span><span>{{localize "OP2.CenaConfig.AcaoTipo"}}</span><span>{{localize "OP2.CenaConfig.AcaoPericia"}}</span><span>DT</span>
              <span>{{localize "OP2.CenaConfig.AcaoAvancos"}}</span><span>{{localize "OP2.CenaConfig.AcaoQuando"}}</span>
              <span data-tooltip="{{localize 'OP2.CenaConfig.AcaoDanoDica'}}">{{localize "OP2.CenaConfig.AcaoDanoCurto"}}</span><span></span>
            </div>
          {{/if}}
          {{#each acoes}}
            <div class="op2-cena-config__acao-area" data-acao-area="{{i}}">
              <input type="text" name="acaoNome" value="{{nome}}" placeholder="{{localize 'OP2.CenaConfig.AcaoNome'}}" aria-label="{{localize 'OP2.CenaConfig.AcaoNome'}}">
              <select name="acaoTipo" aria-label="{{localize 'OP2.CenaConfig.AcaoTipo'}}" data-tooltip="{{localize 'OP2.CenaConfig.AcaoTipoDica'}}">{{#each tipos}}<option value="{{t}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select>
              <select name="acaoPericia" aria-label="{{localize 'OP2.CenaConfig.AcaoPericia'}}">{{#each pericias}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select>
              <input type="number" name="acaoDt" value="{{dt}}" min="1" aria-label="DT">
              <input type="number" name="acaoAvancos" value="{{avancos}}" min="0" aria-label="{{localize 'OP2.CenaConfig.AcaoAvancos'}}">
              <select name="acaoQuando" aria-label="{{localize 'OP2.CenaConfig.AcaoQuando'}}">{{#each quandoOpcoes}}<option value="{{q}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select>
              <input type="text" name="acaoDano" value="{{danoFalha}}" placeholder="1d4" data-tooltip="{{localize 'OP2.CenaConfig.AcaoDanoDica'}}" aria-label="{{localize 'OP2.CenaConfig.AcaoDano'}}">
              <button type="button" class="op2-botao-icone" data-action="remover" data-lista="acoesArea" data-area="{{ai}}" data-i="{{i}}" data-tooltip="{{localize 'OP2.CenaConfig.RemoverAcao'}}"><i class="fa-solid fa-xmark"></i></button>
              {{!-- Segunda linha: o que só alguns tipos usam. --}}
              <div class="op2-cena-config__acao-extra">
                <label data-tooltip="{{localize 'OP2.CenaConfig.AcaoAguaDica'}}">{{localize "OP2.CenaConfig.AcaoAgua"}}<select name="acaoEstado">{{#each estados}}<option value="{{e}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select></label>
                <label data-tooltip="{{localize 'OP2.CenaConfig.AcaoPorAvancoDica'}}">{{localize "OP2.CenaConfig.AcaoPorAvanco"}}<input type="text" name="acaoPorAvanco" value="{{porAvanco}}" placeholder="1d6"></label>
                <label data-tooltip="{{localize 'OP2.CenaConfig.AcaoPericiaBonusDica'}}">{{localize "OP2.CenaConfig.AcaoPericiaBonus"}}<select name="acaoPericiaBonus"><option value="">—</option>{{#each periciasBonus}}<option value="{{k}}" {{#if sel}}selected{{/if}}>{{r}}</option>{{/each}}</select></label>
              </div>
            </div>
          {{/each}}
          <button type="button" class="op2-botao op2-botao--pequeno op2-botao--fantasma" data-action="adicionar" data-lista="acoesArea" data-area="{{ai}}">
            <i class="fa-solid fa-plus"></i> {{localize "OP2.CenaConfig.AdicionarAcao"}}</button>
        </div>
      </div>
    {{/each}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="adicionar" data-lista="areas">
      <i class="fa-solid fa-plus"></i> {{localize "OP2.CenaConfig.AdicionarArea"}}</button>
  </fieldset>

  <footer class="op2-cena-config__rodape">
    {{#if podeExcluir}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="excluirCena"><i class="fa-solid fa-trash"></i> {{localize "OP2.CenaConfig.Excluir"}}</button>{{/if}}
    <button type="submit" class="op2-botao"><i class="fa-solid fa-floppy-disk"></i> {{localize "OP2.CenaConfig.Salvar"}}</button>
  </footer>
</div>
