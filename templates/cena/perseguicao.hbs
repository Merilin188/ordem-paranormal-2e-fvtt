<section class="op2-furt op2-pers">
  <header class="op2-furt__topo">
    {{#if ativa}}
      <div class="op2-furt__fase">
        <small>{{nomeCena}} · {{localize "OP2.Perseguicao.Rodada" n=rodada total=total}}</small>
        <strong>{{#if fim}}{{localize "OP2.Perseguicao.FimTitulo"}}{{else if corte}}{{localize "OP2.Perseguicao.Corte" rodada=corte.rodada pa=corte.pa}}{{else}}{{localize "OP2.Perseguicao.Titulo"}}{{/if}}</strong>
      </div>
      {{#if gm}}
        <div class="op2-furt__botoes">
          {{#unless fim}}
            {{#if inicioNome}}{{#unless cabecas}}<button type="button" class="op2-botao op2-botao--perigo" data-action="cabecas" data-tooltip="{{localize 'OP2.Perseguicao.CabecasDica'}}"><i class="fa-solid fa-dragon"></i> {{inicioNome}}</button>{{/unless}}{{/if}}
            <button type="button" class="op2-botao" data-action="proxima" data-tooltip="{{localize 'OP2.Perseguicao.ProximaDica'}}"><i class="fa-solid fa-forward-step"></i> {{localize "OP2.Perseguicao.FimDaRodada"}}</button>
          {{/unless}}
          <button type="button" class="op2-botao op2-botao--fantasma" data-action="encerrar"><i class="fa-solid fa-flag-checkered"></i> {{localize "OP2.Perseguicao.Encerrar"}}</button>
        </div>
      {{/if}}
    {{else}}
      {{#if gm}}
        <div class="op2-cena-escolha">
          <label>{{localize "OP2.CenaConfig.Visualizando"}}
            <select data-seletor-cena>{{#each cenas}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{nome}}</option>{{/each}}</select></label>
          <div class="op2-furt__botoes">
            <button type="button" class="op2-botao op2-botao--fantasma" data-action="novaCena"><i class="fa-solid fa-plus"></i> {{localize "OP2.CenaConfig.NovaPerseguicao"}}</button>
            <button type="button" class="op2-botao op2-botao--fantasma" data-action="configurar"><i class="fa-solid fa-sliders"></i> {{localize "OP2.CenaConfig.Preparacao"}}</button>
            <button type="button" class="op2-botao" data-action="iniciar"><i class="fa-solid fa-person-running"></i> {{localize "OP2.Perseguicao.Iniciar"}}</button>
          </div>
        </div>
      {{else}}
        <p class="op2-dica">{{localize "OP2.Perseguicao.Inativa"}}</p>
      {{/if}}
    {{/if}}
  </header>

  <div class="op2-furt__criaturas" data-zona="criatura">
    {{#if gm}}
      {{!-- O mestre escreve o nome da criatura aqui mesmo (vale para a cena e fica salvo). --}}
      <input type="text" class="op2-tag op2-tag--secao op2-pers__perseguidor" data-perseguidor value="{{perseguidor}}"
        placeholder="{{localize 'OP2.Perseguicao.Perseguidor'}}" aria-label="{{localize 'OP2.Perseguicao.NomePerseguidor'}}"
        data-tooltip="{{localize 'OP2.Perseguicao.NomePerseguidor'}}">
    {{else}}
      <span class="op2-tag op2-tag--secao">{{#if perseguidor}}{{perseguidor}}{{else}}{{localize "OP2.Perseguicao.Perseguidor"}}{{/if}}</span>
    {{/if}}
    {{#each criaturas}}
      <div class="op2-furt__criatura">
        <img src="{{img}}" alt=""><span>{{nome}}</span>
        {{#if ../gm}}<button type="button" class="op2-botao-icone" data-action="remover" data-uuid="{{uuid}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
      </div>
    {{else}}
      {{#if gm}}<p class="op2-dica">{{localize "OP2.Furtividade.ArrasteCriatura"}}</p>{{/if}}
    {{/each}}
  </div>

  <div class="op2-furt__personagens" data-zona="personagem">
    {{#each participantes}}
      <article class="op2-furt__pj {{#if morto}}op2-furt__pj--encontrado{{/if}} {{#if abaixo}}op2-pers__pj--perigo{{/if}}">
        <img class="op2-furt__retrato" src="{{img}}" alt="" data-action="ficha" data-uuid="{{uuid}}">
        <div class="op2-furt__info">
          <div class="op2-furt__nome">
            <strong>{{nome}}</strong>
            {{#if morto}}<span class="op2-furt__estado op2-furt__estado--encontrado"><i class="fa-solid {{#if alcancado}}fa-person-falling-burst{{else}}fa-skull{{/if}}"></i> {{localize "OP2.Perseguicao.Alcancado"}}</span>{{/if}}
            {{#if ../ativa}}{{#unless morto}}
              <label class="op2-furt__agiu {{#if agiu}}op2-furt__agiu--sim{{/if}}">
                <input type="checkbox" data-action="agiu" data-uuid="{{uuid}}" {{#if agiu}}checked{{/if}} {{#unless podeMarcar}}disabled{{/unless}}>
                {{localize "OP2.Furtividade.JaAgiu"}}</label>
            {{/unless}}{{/if}}
            {{#if ../gm}}<button type="button" class="op2-botao-icone" data-action="remover" data-uuid="{{uuid}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
          </div>
          <div class="op2-pers__trilha">
            <div class="op2-pers__barra"><span style="width: {{largura}}%"></span>
              {{#each ../marcos}}<i class="op2-pers__marca" style="left: {{pos}}%" data-tooltip="{{localize 'OP2.Perseguicao.MarcoDica' rodada=rodada pa=pa}}"></i>{{/each}}
            </div>
            {{#if ../gm}}<input type="number" class="op2-pers__pa" data-pa="{{uuid}}" value="{{pa}}" min="0">{{else}}<strong class="op2-pers__pa">{{pa}}</strong>{{/if}}
            <small>PA</small>
          </div>
          <div class="op2-pers__status">
            {{#if folegoIcones}}<span data-tooltip="{{localize 'OP2.Perseguicao.FolegoDica'}}">{{{folegoIcones}}} {{localize "OP2.Perseguicao.Folego"}}</span>{{/if}}
            {{#if esforcos}}<span><i class="fa-solid fa-heart-crack"></i> {{localize "OP2.Perseguicao.Esforcos" n=esforcos}}</span>{{/if}}
            {{#each eventosP}}<span class="op2-pers__vala--{{resultado}}"><i class="fa-solid fa-person-falling"></i> {{nome}}: {{localize (concat "OP2.Perseguicao.Resultado." resultado)}}</span>{{/each}}
            {{#if sacrificou}}<span><i class="fa-solid fa-hand-fist"></i> {{localize "OP2.Perseguicao.Sacrificio"}}</span>{{/if}}
          </div>
          {{#if podeAgir}}
            <div class="op2-furt__acoes">
              <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo" data-action="jogador" data-acao="avancar" data-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Perseguicao.AvancarDica'}}">{{localize "OP2.Perseguicao.Avancar"}} <small>DT {{../dtAvanco}}</small></button>
              <button type="button" class="op2-botao op2-botao--pequeno" data-action="jogador" data-acao="folego" data-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Perseguicao.RecuperarDica'}}">{{localize "OP2.Perseguicao.Recuperar"}}</button>
              <button type="button" class="op2-botao op2-botao--pequeno" data-action="jogador" data-acao="sacrificio" data-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Perseguicao.SacrificioDica'}}">{{localize "OP2.Perseguicao.Sacrificio"}}</button>
              <button type="button" class="op2-botao op2-botao--pequeno op2-botao--fantasma" data-action="jogador" data-acao="outra" data-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Perseguicao.OutraDica'}}">{{localize "OP2.Perseguicao.Outra"}}</button>
            </div>
          {{else if dono}}{{#if agiu}}{{#unless morto}}
            <p class="op2-dica op2-furt__aguardando"><i class="fa-solid fa-hourglass-half"></i> {{localize "OP2.Furtividade.Aguardando"}}</p>
          {{/unless}}{{/if}}{{/if}}
          {{#each eventosP}}{{#if podeAvisar}}
            <button type="button" class="op2-botao op2-botao--pequeno op2-botao--fantasma" data-action="jogador" data-acao="aviso" data-uuid="{{../uuid}}" data-evento="{{id}}"><i class="fa-solid fa-bullhorn"></i> {{localize "OP2.Perseguicao.AvisarEvento" evento=nome}}</button>
          {{/if}}{{/each}}
        </div>
      </article>
    {{else}}
      <p class="op2-dica op2-furt__soltar">{{#if gm}}{{localize "OP2.Furtividade.ArrastePersonagem"}}{{else}}{{localize "OP2.Furtividade.Ninguem"}}{{/if}}</p>
    {{/each}}
  </div>
</section>
